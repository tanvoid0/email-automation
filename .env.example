# Copy this file to `.env` and fill in values. docker-compose will load it.

# Application
NODE_ENV=production

# Accounts are now created via the /signup page (see lib/models/User.ts) — no
# AUTH_USERNAME/AUTH_PASSWORD env vars anymore. Likewise, each account configures
# its own SMTP in Settings (see lib/models/UserProfile.ts) instead of SMTP_* here.
# If you're upgrading from a single-tenant install, run `pnpm run migrate:multiuser`
# once with your old AUTH_USERNAME/AUTH_PASSWORD/SMTP_* still set to carry them over.

# MongoDB (used in lib/mongodb.ts)
MONGODB_URI=mongodb://user:pass@host:27017/email_automation?authSource=admin

# SMTP timeouts (used in lib/config/timeouts.ts) — values in ms
SMTP_CONNECTION_TIMEOUT=30000
SMTP_SOCKET_TIMEOUT=30000
SMTP_GREETING_TIMEOUT=10000
SMTP_TEST_TIMEOUT=60000

# Google Gemini (used in lib/gemini.ts)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Next.js public URLs (uncomment and adjust if needed)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs login session cookies (lib/session-token.ts). Required, 32+ chars.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
